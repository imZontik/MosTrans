# --- ports ---
HTTP_PORT=8080
PROMETHEUS_PORT=9090
# PostgreSQL and Valkey are published on 127.0.0.1 only
POSTGRES_PORT=5432
VALKEY_PORT=6379

# --- database ---
POSTGRES_USER=magistral
POSTGRES_PASSWORD=magistral
POSTGRES_DB=magistral

# --- backend ---
JWT_SECRET=change-me-in-production
SEED_DEMO_DATA=true
# Random emergency events: one per [N, 2N] seconds of activity
EMERGENCY_MIN_INTERVAL_SEC=900
# Weekly tournament: weekday 0=Mon..6=Sun, Moscow time
TOURNAMENT_WEEKDAY=4
TOURNAMENT_HOUR=18
TOURNAMENT_DURATION_MIN=30

# --- ML service ---
# heuristic (no LLM, works offline) | gigachat | ollama (local Qwen)
ML_PROVIDER=heuristic
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Model for scenario drafts (long JSON graphs); empty — same as GIGACHAT_MODEL
GIGACHAT_HEAVY_MODEL=
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
